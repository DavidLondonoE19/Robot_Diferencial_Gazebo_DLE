<?xml version="1.0"?>
<!-- dle_pista: recta de 6 m con obstáculo, recta de 3 m a 45 grados a la izquierda
     y recta de 5 m a 60 grados a la derecha que se estrecha de 1.4 m a 0.6 m.
     Spawn: x=0 y=0 z=0.1 yaw=0 -->
<sdf version="1.9">
  <world name="dle_pista">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sol">
      <pose>0 0 10 0 0 0</pose>
      <direction>0.3 0.3 -1</direction>
    </light>

  
    <model name="piso">
      <static>true</static>
      <pose>7 1 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

  
    <model name="muro_1">
      <static>true</static>
      <pose>6.2666 -0.6437 0.2500 0 0 0.3927</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5758 0.1000 0.5000</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5758 0.1000 0.5000</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>


